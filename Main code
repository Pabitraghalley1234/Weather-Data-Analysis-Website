import numpy as np
import matplotlib.pyplot as plt
days = np.array([
    "Day 1", "Day 2", "Day 3", "Day 4", "Day 5",
    "Day 6", "Day 7", "Day 8", "Day 9", "Day 10"
])

temperature = np.array([
    25, 28, 30, 27, 32, 29, 26, 31, 24, 28
])

rainfall = np.array([
    5, 0, 10, 15, 2, 8, 20, 0, 12, 6
])

print("WEATHER DATA ANALYSIS")
print("---------------------")

for i in range(len(days)):
    print(days[i],
          "Temperature:", temperature[i], "°C",
          "Rainfall:", rainfall[i], "mm")
    
    avg_temp = np.mean(temperature)
max_temp = np.max(temperature)
min_temp = np.min(temperature)

print("Average Temperature:", avg_temp, "°C")
print("Maximum Temperature:", max_temp, "°C")
print("Minimum Temperature:", min_temp, "°C")

total_rainfall = np.sum(rainfall)
avg_rainfall = np.mean(rainfall)
max_rainfall = np.max(rainfall)
min_rainfall = np.min(rainfall)

print("Total Rainfall:", total_rainfall, "mm")
print("Average Rainfall:", avg_rainfall, "mm")
print("Maximum Rainfall:", max_rainfall, "mm")
print("Minimum Rainfall:", min_rainfall, "mm")

hottest_day = days[np.argmax(temperature)]
coldest_day = days[np.argmin(temperature)]

print("Hottest Day:", hottest_day)
print("Coldest Day:", coldest_day)

plt.figure(figsize=(10, 5))

plt.plot(days, temperature, marker='o')

plt.title("Daily Temperature Analysis")
plt.xlabel("Days")
plt.ylabel("Temperature (°C)")

plt.grid(True)
plt.show()

plt.figure(figsize=(10, 5))

plt.bar(days, rainfall)

plt.title("Daily Rainfall Analysis")
plt.xlabel("Days")
plt.ylabel("Rainfall (mm)")

plt.show()

plt.figure(figsize=(12, 7))

plt.subplot(2, 1, 1)

plt.plot(days, temperature, marker='o')
plt.title("Temperature and Rainfall Comparison")
plt.ylabel("Temperature (°C)")
plt.grid(True)

plt.subplot(2, 1, 2)

plt.bar(days, rainfall)
plt.xlabel("Days")
plt.ylabel("Rainfall (mm)")

plt.tight_layout()
plt.show()
